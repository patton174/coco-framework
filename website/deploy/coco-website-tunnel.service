[Unit]
Description=Coco website Cloudflare Tunnel
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
ExecStart=/opt/coco-website/bin/cloudflared --no-autoupdate tunnel --config /opt/coco-website/config/tunnel.yml run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
