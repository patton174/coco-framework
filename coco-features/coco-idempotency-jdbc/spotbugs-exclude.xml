<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- SQL text only interpolates identifiers validated by CocoIdempotencyJdbcProperties. -->
    <Match>
        <Class name="io.github.coco.feature.idempotency.jdbc.JdbcCocoIdempotencyStore"/>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
    <!-- JDBC errors intentionally become a parameter-free Spring data-access exception. -->
    <Match>
        <Class name="io.github.coco.feature.idempotency.jdbc.JdbcCocoIdempotencyStore"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
</FindBugsFilter>
